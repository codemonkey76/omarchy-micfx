# ---------------------------------------------------------------- output

def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def fail(message, code=1):
    emit({"ok": False, "error": message})
    sys.exit(code)


def lin(db):
    return 10 ** (db / 20.0)


def to_db(value):
    return 20 * math.log10(value) if value > 0 else -120.0


# ------------------------------------------------- programs and their children
# Nothing here is looked up through PATH, and nothing is resolved twice. Every
# program this helper runs is found once, in a system directory opened one
# component at a time from / and checked the whole way down, and then *kept
# open*: what is executed is the descriptor that was checked, named to execve
# as /proc/self/fd/N, which is what fexecve does. There is no window in which a
# directory entry could be swapped between the check and the exec, and nothing
# a non-root user can write is ever a candidate. Children start from a closed
# environment -- only the handful of variables PipeWire, PulseAudio and
# `systemctl --user` need to find this session -- in a process group of their
# own, so stopping one stops everything it started rather than leaving a tree
# behind.

# Only the two distribution directories, which are the same directory on
# Omarchy (/bin is root's own symlink to usr/bin). /usr/local/bin is left out
# deliberately: every program used here ships with PipeWire, PulseAudio or
# systemd, so there is nothing to gain from trusting the directory a local
# build lands in.
TOOL_DIRS = ("/usr/bin", "/bin")
# What the session needs to be findable; everything else is dropped.
SESSION_ENV = ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "XDG_SESSION_TYPE",
               "WAYLAND_DISPLAY", "DISPLAY", "PULSE_SERVER", "PULSE_COOKIE",
               "PIPEWIRE_RUNTIME_DIR", "PIPEWIRE_REMOTE", "USER", "LOGNAME")
MAX_OUTPUT = 4 << 20          # what one command may print before it is cut off
GRACE = 2.0                   # how long a child has to stop before it is killed
LINK_HOPS = 8                 # how far a chain of root's own symlinks may go

_tools = {}
_tool_dirs = None
_children = []
_children_lock = threading.Lock()


def root_owned_dir(fd):
    """True if an open descriptor is a directory only root can write."""
    try:
        st = os.fstat(fd)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and not st.st_mode & 0o022


def system_dir(path):
    """A descriptor for a system directory, or None unless every directory on
    the way to it -- / included -- is root's own and writable by nobody else."""
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        if not root_owned_dir(fd):
            return None
        for name in [p for p in path.split("/") if p]:
            if name in (".", ".."):
                return None
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
            # /bin -> usr/bin is root's own link, and followed; anyone else's
            # is not, and a real directory is opened without following at all.
            if stat.S_ISLNK(st.st_mode):
                if st.st_uid != 0:
                    return None
            else:
                flags |= os.O_NOFOLLOW
            child = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = child
            if not root_owned_dir(fd):
                return None
        keep, fd = fd, None
        return keep
    except OSError:
        return None
    finally:
        if fd is not None:
            os.close(fd)


def system_dirs():
    global _tool_dirs
    if _tool_dirs is None:
        _tool_dirs = [fd for fd in [system_dir(p) for p in TOOL_DIRS] if fd is not None]
    return _tool_dirs


def open_program(dir_fd, name):
    """A descriptor for a program inside an already-checked directory, or None.
    The file itself is opened without following symlinks; a link root wrote --
    /usr/bin/parec -> pacat, say -- is resolved by hand, a plain name at a
    time, inside that same directory, so resolution can never leave it."""
    for _ in range(LINK_HOPS):
        try:
            st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        except OSError:
            return None
        if stat.S_ISLNK(st.st_mode):
            if st.st_uid != 0:
                return None
            try:
                target = os.readlink(name, dir_fd=dir_fd)
            except OSError:
                return None
            if "/" in target or target in ("", ".", ".."):
                return None
            name = target
            continue
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
        except OSError:
            return None
        # A real program, root's own, that only root can replace. Checked on
        # the descriptor, which is also the thing that gets executed.
        st = os.fstat(fd)
        if (stat.S_ISREG(st.st_mode) and st.st_uid == 0
                and not st.st_mode & 0o022 and st.st_mode & 0o111):
            return fd
        os.close(fd)
        return None
    return None


def tool(name):
    """An open descriptor for a trusted system program, or None if there isn't one."""
    if name not in _tools:
        found = None
        if name and "/" not in name and name not in (".", ".."):
            for dir_fd in system_dirs():
                found = open_program(dir_fd, name)
                if found is not None:
                    break
        _tools[name] = found
    return _tools[name]


def child_env():
    return dict([("PATH", "/usr/bin:/bin"), ("HOME", HOME), ("LC_ALL", "C.UTF-8")] +
                [(key, os.environ[key]) for key in SESSION_ENV if key in os.environ])


def spawn(args, stdout=None, stdin=None):
    """Start a trusted program in its own process group, or None if it won't
    start. The descriptor found by `tool` is what runs: naming it through
    /proc/self/fd leaves the kernel nothing to resolve. argv[0] stays the name
    that was asked for, which pacat reads to tell recording from playback."""
    fd = tool(args[0])
    if fd is None:
        return None
    try:
        proc = subprocess.Popen([str(a) for a in args],
                                executable="/proc/self/fd/%d" % fd,
                                # The one descriptor the child keeps: read-only,
                                # on the program it is itself running. Everything
                                # else of ours is closed before it starts.
                                pass_fds=(fd,),
                                stdin=stdin,
                                stdout=subprocess.DEVNULL if stdout is None else stdout,
                                stderr=subprocess.DEVNULL,
                                env=child_env(), close_fds=True, start_new_session=True)
    except OSError:
        return None
    with _children_lock:
        _children.append(proc)
    return proc


def signal_group(proc, number):
    try:
        os.killpg(os.getpgid(proc.pid), number)
    except OSError:
        try:
            proc.send_signal(number)
        except OSError:
            pass


def stop(proc, grace=GRACE):
    """Stop a child and everything it started, then collect it."""
    if proc is None:
        return
    if proc.poll() is None:
        signal_group(proc, signal.SIGTERM)
        try:
            proc.wait(timeout=grace)
        except subprocess.TimeoutExpired:
            signal_group(proc, signal.SIGKILL)
            try:
                proc.wait(timeout=grace)
            except subprocess.TimeoutExpired:
                pass
    for stream in (proc.stdin, proc.stdout, proc.stderr):
        try:
            if stream is not None:
                stream.close()
        except OSError:
            pass
    with _children_lock:
        if proc in _children:
            _children.remove(proc)


# However this helper ends -- its own doing, or the widget asking it to stop --
# nothing it started is left running.
def stop_all(*_):
    with _children_lock:
        running = list(_children)
    for proc in running:
        stop(proc, grace=1.0)


def on_signal(*_):
    stop_all()
    sys.exit(130)


def supervise():
    atexit.register(stop_all)
    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        try:
            signal.signal(number, on_signal)
        except (OSError, ValueError):
            pass


# ---------------------------------------------------------------- files
# Every directory is opened one component at a time from /, never following a
# symlink unless root owns it (an administrator's choice, such as /home
# pointing elsewhere). Reads accept only a small regular file of ours; writes
# go to a random O_EXCL temporary file that is fsynced and renamed into place
# relative to the directory already held open.

def open_dir(path, create):
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for name in [p for p in path.split("/") if p]:
            if name in (".", ".."):
                raise OSError("path contains . or ..")
            try:
                st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                if not create:
                    return None
                os.mkdir(name, 0o700, dir_fd=fd)
                st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
            if stat.S_ISLNK(st.st_mode):
                if st.st_uid != 0:
                    raise OSError("not following the symlink at %r in %s" % (name, path))
            else:
                flags |= os.O_NOFOLLOW
            child = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = child
        st = os.fstat(fd)
        if st.st_uid != os.getuid() or st.st_mode & 0o022:
            raise OSError("%s must be yours and not writable by others" % path)
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_file(directory, name, limit=1 << 20, binary=False):
    parent = open_dir(directory, create=False)
    if parent is None:
        return None
    try:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=parent)
        except FileNotFoundError:
            return None
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or st.st_size > limit:
                raise OSError("ignoring unexpected file %s/%s" % (directory, name))
            chunks, total = [], 0
            while True:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise OSError("%s/%s is too large" % (directory, name))
                chunks.append(chunk)
            data = b"".join(chunks)
            return data if binary else data.decode("utf-8")
        finally:
            os.close(fd)
    finally:
        os.close(parent)


def write_file(directory, name, text, mode=0o600):
    parent = open_dir(directory, create=True)
    tmp = ".%s.%s" % (name, secrets.token_hex(8))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=parent)
        try:
            data = text.encode("utf-8") if isinstance(text, str) else bytes(text)
            while data:
                data = data[os.write(fd, data):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, name, src_dir_fd=parent, dst_dir_fd=parent)
        os.fsync(parent)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=parent)
        except OSError:
            pass
        raise
    finally:
        os.close(parent)


def remove_file(directory, name):
    parent = open_dir(directory, create=False)
    if parent is None:
        return
    try:
        os.unlink(name, dir_fd=parent)
    except FileNotFoundError:
        pass
    finally:
        os.close(parent)


def read_json(directory, name, default):
    try:
        text = read_file(directory, name)
        return json.loads(text) if text else default
    except (OSError, ValueError):
        return default


# ---------------------------------------------------------------- settings

def coerce(key, value):
    default, low, high = SETTINGS[key]
    if isinstance(default, bool):
        if isinstance(value, bool):
            return value
        text = str(value).strip().lower()
        if text in ("1", "true", "on", "yes"):
            return True
        if text in ("0", "false", "off", "no"):
            return False
        raise ValueError("%s takes on or off" % key)
    number = float(value)
    if not math.isfinite(number):
        raise ValueError("%s must be a number" % key)
    return round(min(high, max(low, number)), 2)


def load_settings():
    stored = read_json(SETTINGS_DIR, "settings.json", {})
    settings = {key: spec[0] for key, spec in SETTINGS.items()}
    for key in SETTINGS:
        if key in stored:
            try:
                settings[key] = coerce(key, stored[key])
            except (TypeError, ValueError):
                pass
    device = stored.get("device", "")
    settings["device"] = device if isinstance(device, str) and valid_node_name(device) else ""
    return settings


def save_settings(settings):
    write_file(SETTINGS_DIR, "settings.json", json.dumps(settings, indent=2, sort_keys=True) + "\n")


def valid_node_name(name):
    return bool(re.fullmatch(r"[A-Za-z0-9_.:@+-]{1,200}", name or ""))


