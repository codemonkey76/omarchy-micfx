# ---------------------------------------------------------------- output

def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def fail(message, code=1):
    emit({"ok": False, "error": message})
    sys.exit(code)


def lin(db):
    return 10 ** (db / 20.0)


def to_db(value):
    return 20 * math.log10(value) if value > 0 else -120.0


# ---------------------------------------------------------------- files
# Every directory is opened one component at a time from /, never following a
# symlink unless root owns it (an administrator's choice, such as /home
# pointing elsewhere). Reads accept only a small regular file of ours; writes
# go to a random O_EXCL temporary file that is fsynced and renamed into place
# relative to the directory already held open.

def open_dir(path, create):
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for name in [p for p in path.split("/") if p]:
            if name in (".", ".."):
                raise OSError("path contains . or ..")
            try:
                st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                if not create:
                    return None
                os.mkdir(name, 0o700, dir_fd=fd)
                st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
            if stat.S_ISLNK(st.st_mode):
                if st.st_uid != 0:
                    raise OSError("not following the symlink at %r in %s" % (name, path))
            else:
                flags |= os.O_NOFOLLOW
            child = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = child
        st = os.fstat(fd)
        if st.st_uid != os.getuid() or st.st_mode & 0o022:
            raise OSError("%s must be yours and not writable by others" % path)
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_file(directory, name, limit=1 << 20, binary=False):
    parent = open_dir(directory, create=False)
    if parent is None:
        return None
    try:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=parent)
        except FileNotFoundError:
            return None
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or st.st_size > limit:
                raise OSError("ignoring unexpected file %s/%s" % (directory, name))
            chunks, total = [], 0
            while True:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise OSError("%s/%s is too large" % (directory, name))
                chunks.append(chunk)
            data = b"".join(chunks)
            return data if binary else data.decode("utf-8")
        finally:
            os.close(fd)
    finally:
        os.close(parent)


def write_file(directory, name, text, mode=0o600):
    parent = open_dir(directory, create=True)
    tmp = ".%s.%s" % (name, secrets.token_hex(8))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=parent)
        try:
            data = text.encode("utf-8") if isinstance(text, str) else bytes(text)
            while data:
                data = data[os.write(fd, data):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, name, src_dir_fd=parent, dst_dir_fd=parent)
        os.fsync(parent)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=parent)
        except OSError:
            pass
        raise
    finally:
        os.close(parent)


def remove_file(directory, name):
    parent = open_dir(directory, create=False)
    if parent is None:
        return
    try:
        os.unlink(name, dir_fd=parent)
    except FileNotFoundError:
        pass
    finally:
        os.close(parent)


def read_json(directory, name, default):
    try:
        text = read_file(directory, name)
        return json.loads(text) if text else default
    except (OSError, ValueError):
        return default


# ---------------------------------------------------------------- settings

def coerce(key, value):
    default, low, high = SETTINGS[key]
    if isinstance(default, bool):
        if isinstance(value, bool):
            return value
        text = str(value).strip().lower()
        if text in ("1", "true", "on", "yes"):
            return True
        if text in ("0", "false", "off", "no"):
            return False
        raise ValueError("%s takes on or off" % key)
    number = float(value)
    if not math.isfinite(number):
        raise ValueError("%s must be a number" % key)
    return round(min(high, max(low, number)), 2)


def load_settings():
    stored = read_json(SETTINGS_DIR, "settings.json", {})
    settings = {key: spec[0] for key, spec in SETTINGS.items()}
    for key in SETTINGS:
        if key in stored:
            try:
                settings[key] = coerce(key, stored[key])
            except (TypeError, ValueError):
                pass
    device = stored.get("device", "")
    settings["device"] = device if isinstance(device, str) and valid_node_name(device) else ""
    return settings


def save_settings(settings):
    write_file(SETTINGS_DIR, "settings.json", json.dumps(settings, indent=2, sort_keys=True) + "\n")


def valid_node_name(name):
    return bool(re.fullmatch(r"[A-Za-z0-9_.:@+-]{1,200}", name or ""))


# The chain's controls, in the plugins' own units, for a set of settings.
def controls(s):
    c = {
        "pre:Gain 1": lin(s["gain"]),
        "hp:Freq": s["hpf.freq"] if s["hpf.enabled"] else 5.0,
        "hp:Q": 0.707,
        "rnnoise:Dry Mix": (1 - s["suppress.strength"] / 100.0) if s["suppress.enabled"] else 1.0,
        "rnnoise:VAD Threshold (%)": s["suppress.vad"] if s["suppress.enabled"] else 0.0,
        "rnnoise:VAD Grace Period (ms)": 200.0,
        "rnnoise:Retroactive VAD Grace (ms)": 50.0,
        "gate:enabled": 1.0 if s["gate.enabled"] else 0.0,
        "gate:gt": lin(s["gate.threshold"]),
        "gate:gz": max(0.001, lin(-s["gate.hysteresis"])),
        "gate:gr": lin(s["gate.range"]),
        "gate:at": s["gate.attack"],
        "gate:hold": s["gate.hold"],
        "gate:rt": s["gate.release"],
        "gate:mk": 1.0,
        "comp:enabled": 1.0 if s["comp.enabled"] else 0.0,
        "comp:cm": 0.0,
        "comp:al": lin(s["comp.threshold"]),
        "comp:cr": s["comp.ratio"],
        "comp:kn": max(0.0631, lin(-s["comp.knee"])),
        "comp:at": s["comp.attack"],
        "comp:rt": s["comp.release"],
        "comp:mk": lin(s["comp.makeup"]),
        "limit:enabled": 1.0 if s["limit.enabled"] else 0.0,
        "limit:alr": 0.0,
        "limit:boost": 0.0,
        "limit:th": lin(s["limit.ceiling"]),
        "limit:lk": 5.0,
        "limit:at": 5.0,
        "limit:rt": s["limit.release"],
    }
    return c


# ---------------------------------------------------------------- audio graph

def run(args, timeout=10, check=False):
    try:
        done = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if check and done.returncode != 0:
        return None
    return done


def sources():
    done = run(["pactl", "-f", "json", "list", "sources"])
    if not done or done.returncode != 0:
        return []
    try:
        return json.loads(done.stdout)
    except ValueError:
        return []


def input_devices():
    out = []
    for src in sources():
        name = src.get("name", "")
        props = src.get("properties", {})
        # Not our own sources (the chain, its preview), and not monitors of outputs.
        if name.startswith(SOURCE) or name.endswith(".monitor") or props.get("device.class") == "monitor":
            continue
        if not valid_node_name(name):
            continue
        out.append({"name": name, "description": src.get("description") or name,
                    "channels": src.get("channel_map", "").count(",") + 1 if src.get("channel_map") else 1})
    return out


def default_source():
    done = run(["pactl", "get-default-source"])
    return done.stdout.strip() if done and done.returncode == 0 else ""


def source_present(name):
    return any(src.get("name") == name for src in sources())


def capture_node_id():
    done = run(["pw-dump"], timeout=10)
    if not done or done.returncode != 0:
        return None
    try:
        for obj in json.loads(done.stdout):
            props = (obj.get("info") or {}).get("props") or {}
            if obj.get("type") == "PipeWire:Interface:Node" and props.get("node.name") == CAPTURE:
                return obj.get("id")
    except ValueError:
        pass
    return None


# Device descriptions come from the hardware (a USB device names itself), so
# they're quoted, stripped of control characters and capped before they go
# into the generated config.
def spa_string(text):
    text = "".join(ch for ch in str(text)[:200] if ch >= " " and ch != "\x7f")
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def source_state():
    for src in sources():
        if src.get("name") == SOURCE:
            return src.get("state", "")
    return ""


def node_controls(node):
    done = run(["pw-dump", str(node)], timeout=10)
    found = {}
    if not done or done.returncode != 0:
        return found
    try:
        for obj in json.loads(done.stdout):
            for props in ((obj.get("info") or {}).get("params") or {}).get("Props") or []:
                params = props.get("params") or []
                for i in range(0, len(params) - 1, 2):
                    if isinstance(params[i], str) and isinstance(params[i + 1], (int, float)):
                        found[params[i]] = float(params[i + 1])
    except ValueError:
        pass
    return found


def controls_match(node, values):
    current = node_controls(node)
    return all(k in current and abs(current[k] - float(v)) <= 1e-4 * max(1.0, abs(float(v))) for k, v in values.items())


# A chain that hasn't processed audio since it started is suspended and
# ignores control changes, so hold it awake with a throwaway recording while
# they land, then read them back rather than assume.
def apply_live(values):
    node = capture_node_id()
    if node is None:
        return False
    waker = subprocess.Popen(["parec", "-d", SOURCE, "--raw"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        wait_for(lambda: source_state() == "RUNNING", 3)
        params = " ".join("%s %s" % (spa_string(k), repr(float(v))) for k, v in values.items())
        run(["pw-cli", "set-param", str(node), "Props", "{ params = [ %s ] }" % params])
        return wait_for(lambda: controls_match(node, values), 3)
    finally:
        waker.terminate()
        try:
            waker.wait(timeout=2)
        except subprocess.TimeoutExpired:
            waker.kill()


def resolve_device(settings):
    if settings["device"]:
        return settings["device"]
    current = default_source()
    if current and current != SOURCE and valid_node_name(current):
        return current
    devices = input_devices()
    return devices[0]["name"] if devices else ""


def describe(device):
    for d in input_devices():
        if d["name"] == device:
            return d["description"]
    return device


# With preview, the chain is a throwaway copy that captures a temporary sink
# instead of a microphone, under its own node names.
def render(settings, device, preview=False):
    c = controls(settings)
    fmt = lambda v: ("%.6f" % v).rstrip("0").rstrip(".") if isinstance(v, float) else str(v)
    def block(prefix):
        items = ["%s = %s" % (spa_string(k.split(":", 1)[1]), fmt(v)) for k, v in c.items() if k.startswith(prefix + ":")]
        return "{ " + " ".join(items) + " }"
    label = spa_string("Mic FX preview" if preview else describe(device) + " (Mic FX)")
    return """# Written by omarchy-mic-fx. Changes here are overwritten; use the widget or
# `omarchy-mic-fx set` instead.

context.properties = {{ log.level = 2 }}

context.spa-libs = {{
  audio.convert.* = audioconvert/libspa-audioconvert
  support.*       = support/libspa-support
}}

context.modules = [
  {{ name = libpipewire-module-rt args = {{ }} flags = [ ifexists nofail ] }}
  {{ name = libpipewire-module-protocol-native }}
  {{ name = libpipewire-module-client-node }}
  {{ name = libpipewire-module-adapter }}
  {{ name = libpipewire-module-filter-chain
    args = {{
      node.description = {label}
      media.name       = {label}
      filter.graph = {{
        nodes = [
          {{ type = builtin name = pre label = mixer control = {pre} }}
          {{ type = builtin name = hp label = bq_highpass control = {hp} }}
          {{ type = ladspa name = rnnoise plugin = "librnnoise_ladspa" label = noise_suppressor_mono control = {rnnoise} }}
          {{ type = lv2 name = gate plugin = "{lsp}gate_mono" control = {gate} }}
          {{ type = lv2 name = comp plugin = "{lsp}compressor_mono" control = {comp} }}
          {{ type = lv2 name = limit plugin = "{lsp}limiter_mono" control = {limit} }}
        ]
        links = [
          {{ output = "pre:Out"        input = "hp:In" }}
          {{ output = "hp:Out"         input = "rnnoise:Input" }}
          {{ output = "rnnoise:Output" input = "gate:in" }}
          {{ output = "gate:out"       input = "comp:in" }}
          {{ output = "comp:out"       input = "limit:in" }}
        ]
        inputs  = [ "pre:In 1" ]
        outputs = [ "limit:out" ]
      }}
      audio.channels = 1
      audio.position = [ MONO ]
      capture.props = {{
        node.name          = "{capture}"
        node.passive       = {passive}
        target.object      = {device}{capture_sink}
        # Wait for this device rather than processing whatever else is there.
        node.dont-fallback = true
        node.linger        = true
        node.dont-move     = true
      }}
      playback.props = {{
        node.name   = "{source}"
        media.class = Audio/Source
      }}
    }}
  }}
]
""".format(label=label, pre=block("pre"), hp=block("hp"), rnnoise=block("rnnoise"), gate=block("gate"),
           comp=block("comp"), limit=block("limit"), lsp=LSP_URI,
           capture=PREVIEW_CAPTURE if preview else CAPTURE, source=PREVIEW_SOURCE if preview else SOURCE,
           passive="false" if preview else "true",
           capture_sink="\n        stream.capture.sink = true" if preview else "",
           device=spa_string(device))


UNIT_TEXT = """# Written by omarchy-mic-fx.
[Unit]
Description=Omarchy Mic FX (processed microphone)
After=pipewire.service wireplumber.service
Requires=pipewire.service
Wants=wireplumber.service
# The filter-chain loses its connection when PipeWire goes away.
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c {conf}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
""".format(conf=HOST_CONF)


def systemctl(*args):
    return run(["systemctl", "--user"] + list(args), timeout=30)


def service_state():
    done = systemctl("is-active", UNIT)
    active = done.stdout.strip() if done else "unknown"
    done = systemctl("is-enabled", UNIT)
    enabled = done.stdout.strip() if done else "unknown"
    return active or "inactive", enabled or "disabled"


def deps_present():
    return {"rnnoise": os.path.exists(RNNOISE),
            "lsp": all(os.path.exists(os.path.join(LSP, p + ".ttl")) for p in ("gate_mono", "compressor_mono", "limiter_mono"))}


def install_files(settings, device):
    write_file(PIPEWIRE_DIR, HOST_CONF, render(settings, device), 0o644)
    write_file(UNIT_DIR, UNIT, UNIT_TEXT, 0o644)
    systemctl("daemon-reload")


# Recording streams from apps. Our own capture stream carries no application name.
def app_source_outputs(on_source):
    done = run(["pactl", "-f", "json", "list", "source-outputs"])
    if not done or done.returncode != 0:
        return []
    try:
        outputs = json.loads(done.stdout)
    except ValueError:
        return []
    index = {src.get("index"): src.get("name") for src in sources()}
    ids = []
    for out in outputs:
        props = out.get("properties", {})
        if props.get("node.name") == CAPTURE or not props.get("application.name"):
            continue
        if index.get(out.get("source")) == on_source:
            ids.append(str(out.get("index")))
    return ids


def move_apps(from_source, to_source):
    for oid in app_source_outputs(from_source):
        run(["pactl", "move-source-output", oid, to_source])


def wait_for(predicate, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if predicate():
            return True
        time.sleep(0.25)
    return predicate()


# ---------------------------------------------------------------- commands

def cmd_status():
    settings = load_settings()
    active, enabled = service_state()
    device = resolve_device(settings)
    present = source_present(SOURCE)
    calib = {p: read_file(CALIBRATION_DIR, p + ".json", 4 << 20) is not None for p in ("quiet", "speech", "typing")}
    emit({
        "ok": True,
        "deps": deps_present(),
        "service": active,
        "enabled": enabled == "enabled",
        "present": present,
        "isDefault": present and default_source() == SOURCE,
        "device": {"name": device, "description": describe(device) if device else "",
                   "present": bool(device) and source_present(device)},
        "devices": input_devices(),
        "settings": {k: settings[k] for k in SETTINGS},
        "calibration": {"phases": calib, "suggestion": read_json(CALIBRATION_DIR, "suggestion.json", None)},
    })


def cmd_on(keep_default):
    deps = deps_present()
    if not all(deps.values()):
        fail("missing " + " and ".join(k for k, v in deps.items() if not v) +
             ": install noise-suppression-for-voice and lsp-plugins-lv2")
    settings = load_settings()
    device = resolve_device(settings)
    if not device or not source_present(device):
        fail("no input device to process")
    if not settings["device"]:
        settings["device"] = device
        save_settings(settings)
    install_files(settings, device)
    systemctl("enable", UNIT)
    systemctl("restart", UNIT)
    if not wait_for(lambda: source_present(SOURCE), 10):
        systemctl("disable", "--now", UNIT)
        fail("the processed source never appeared; see: systemctl --user status " + UNIT)
    if not keep_default:
        current = default_source()
        if current and current != SOURCE:
            write_file(STATE_DIR, "previous-default", current + "\n")
        run(["pactl", "set-default-source", SOURCE])
        move_apps(device, SOURCE)
    emit({"ok": True, "source": SOURCE, "device": device, "isDefault": default_source() == SOURCE})


def cmd_default():
    if not source_present(SOURCE):
        fail("Mic FX isn't on")
    device = resolve_device(load_settings())
    current = default_source()
    if current and current != SOURCE:
        write_file(STATE_DIR, "previous-default", current + "\n")
    run(["pactl", "set-default-source", SOURCE])
    move_apps(device, SOURCE)
    emit({"ok": True, "isDefault": default_source() == SOURCE})


def cmd_off():
    settings = load_settings()
    device = resolve_device(settings)
    previous = (read_file(STATE_DIR, "previous-default", 4096) or "").strip()
    fallback = previous if previous and previous != SOURCE and source_present(previous) else device
    if default_source() == SOURCE and fallback:
        run(["pactl", "set-default-source", fallback])
    if fallback:
        move_apps(SOURCE, fallback)
    systemctl("disable", "--now", UNIT)
    wait_for(lambda: not source_present(SOURCE), 5)
    emit({"ok": True, "default": default_source()})


def cmd_set(key, value):
    if key not in SETTINGS:
        fail("unknown setting %r" % key)
    settings = load_settings()
    try:
        settings[key] = coerce(key, value)
    except (TypeError, ValueError) as e:
        fail(str(e))
    save_settings(settings)
    stage = key.split(".")[0]
    prefix = {"gain": "pre", "hpf": "hp", "suppress": "rnnoise", "gate": "gate", "comp": "comp", "limit": "limit"}[stage]
    live = False
    if source_present(SOURCE):
        live = apply_live({k: v for k, v in controls(settings).items() if k.startswith(prefix + ":")})
        write_file(PIPEWIRE_DIR, HOST_CONF, render(settings, resolve_device(settings)), 0o644)
    emit({"ok": True, "key": key, "value": settings[key], "live": live})


def cmd_device(name):
    if not valid_node_name(name) or not any(d["name"] == name for d in input_devices()):
        fail("no input device named %r" % name)
    settings = load_settings()
    settings["device"] = name
    save_settings(settings)
    if source_present(SOURCE):
        install_files(settings, name)
        systemctl("restart", UNIT)
        wait_for(lambda: source_present(SOURCE), 10)
    emit({"ok": True, "device": name})


def cmd_reset():
    settings = load_settings()
    fresh = {key: spec[0] for key, spec in SETTINGS.items()}
    fresh["device"] = settings["device"]
    save_settings(fresh)
    if source_present(SOURCE):
        apply_live(controls(fresh))
        write_file(PIPEWIRE_DIR, HOST_CONF, render(fresh, resolve_device(fresh)), 0o644)
