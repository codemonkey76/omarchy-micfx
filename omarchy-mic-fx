    live = False
    if source_present(SOURCE):
        live = apply_live(controls(settings))
        write_file(PIPEWIRE_DIR, HOST_CONF, render(settings, resolve_device(settings)), 0o644)
    emit({"ok": True, "live": live, "settings": {k: settings[k] for k in SETTINGS}})


# ---------------------------------------------------------------- preview
# The wizard's last step plays the typing mixed over the talking, first as
# recorded and then through the suggested settings. The processed version
# comes from a throwaway copy of the chain fed through a temporary null sink,
# so the real chain, and any call using it, is never touched. Clips are
# played from memory through pacat's stdin, never re-opened by path.

def pcm16(samples):
    return array.array("h", (max(-32767, min(32767, int(s * 32767))) for s in samples)).tobytes()


def wav_bytes(samples):
    out = io.BytesIO()
    with wave.open(out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm16(samples))
    return out.getvalue()


def wav_frames(data):
    with wave.open(io.BytesIO(data), "rb") as w:
        if w.getnchannels() != 1 or w.getsampwidth() != 2 or w.getframerate() != RATE:
            raise ValueError("unexpected clip format")
        return w.readframes(w.getnframes())


def read_clip(name):
    data = read_file(RUNTIME_DIR, name, 32 << 20, binary=True)
    if data is None:
        return None
    return [x / 32767.0 for x in array.array("h", wav_frames(data))]


def feed(proc, pcm):
    # Writes block once pacat's buffer is full, so progress tracks playback.
    # A player that goes away mid-clip ends the feed; it isn't an error.
    step = WINDOW * 2
    try:
        for offset in range(0, len(pcm), step):
            proc.stdin.write(pcm[offset:offset + step])
            sys.stdout.write("progress %.3f\n" % min(1.0, (offset + step) / float(len(pcm))))
            sys.stdout.flush()
        proc.stdin.close()
    except (BrokenPipeError, OSError, ValueError):
        pass


def suggested_settings():
    settings = load_settings()
    suggestion = read_json(CALIBRATION_DIR, "suggestion.json", None)
    if suggestion and isinstance(suggestion.get("suggested"), dict):
        for key, value in suggestion["suggested"].items():
            if key in SETTINGS:
                settings[key] = coerce(key, value)
    return settings


def default_sink():
    done = run(["pactl", "get-default-sink"])
    return done.stdout.strip() if done and done.returncode == 0 else ""


def cmd_calibrate_preview():
    speech, typing = read_clip("speech.wav"), read_clip("typing.wav")
    if not speech or not typing:
        fail("record the talking and typing steps first")
    # The typing runs under the whole of the talking, looped if it's shorter.
    mix = [max(-1.0, min(1.0, s + typing[i % len(typing)])) for i, s in enumerate(speech)]
    write_file(RUNTIME_DIR, "before.wav", wav_bytes(mix), 0o600)
    settings = suggested_settings()
    sink_before, source_before = default_sink(), default_source()
    module = chain = recorder = player = None
    captured = []
    lead = 0
    # The preview is the clip's own length plus a little room for the chain to
    # start and its tail to come through -- never more audio than that, and
    # never longer than that, whatever the chain does.
    clip_seconds = len(mix) / float(RATE)
    ceiling = int((clip_seconds + 5.0) * RATE) * 4
    deadline = time.monotonic() + clip_seconds + 60.0
    try:
        done = run(["pactl", "load-module", "module-null-sink", "sink_name=" + PREVIEW_SINK,
                    "sink_properties=device.description=Mic-FX-preview"])
        module = done.stdout.strip() if done and done.returncode == 0 else None
        if not module:
            fail("couldn't create the preview's temporary sink")
        write_file(RUNTIME_DIR, "preview.conf", render(settings, PREVIEW_SINK, preview=True), 0o600)
        chain = spawn(["pipewire", "-c", os.path.join(RUNTIME_DIR, "preview.conf")])
        if chain is None:
            fail("couldn't start the preview chain")
        if not wait_for(lambda: source_present(PREVIEW_SOURCE), 8):
            fail("the preview chain didn't start")
        recorder = spawn(["parec", "-d", PREVIEW_SOURCE, "--format=float32le", "--rate=%d" % RATE,
                          "--channels=1", "--raw", "--latency-msec=50"], stdout=subprocess.PIPE)
        if recorder is None:
            fail("couldn't record the preview")
        def collect():
            taken = 0
            while taken < ceiling and time.monotonic() < deadline:
                chunk = recorder.stdout.read(WINDOW * 4)
                if not chunk:
                    break
                taken += len(chunk)
                captured.append(chunk)
        reader = threading.Thread(target=collect, daemon=True)
        reader.start()
        time.sleep(0.3)
        lead = sum(len(c) for c in captured) // 4      # samples recorded before the clip starts
        player = spawn(["pacat", "--playback", "-d", PREVIEW_SINK, "--format=s16le",
                        "--rate=%d" % RATE, "--channels=1", "--latency-msec=100"],
                       stdin=subprocess.PIPE)
        if player is None:
            fail("couldn't play the clip through the preview chain")
        feed(player, pcm16(mix))
        try:
            player.wait(timeout=max(1.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            fail("the preview didn't finish in time")
        time.sleep(0.5)                                 # let the chain's tail through
        stop(recorder)
        reader.join(timeout=3)
    finally:
        for proc in (player, recorder, chain):
            stop(proc)
        if module:
            run(["pactl", "unload-module", module])
        if sink_before and default_sink() != sink_before:
            run(["pactl", "set-default-sink", sink_before])
        if source_before and default_source() != source_before:
            run(["pactl", "set-default-source", source_before])
        remove_file(RUNTIME_DIR, "preview.conf")
    processed = array.array("f", b"".join(captured))
    after = processed[lead:lead + len(mix)]
    if len(after) < RATE:
        fail("the preview chain returned too little audio")
    write_file(RUNTIME_DIR, "after.wav", wav_bytes(after), 0o600)
    emit({"ok": True, "seconds": round(len(mix) / float(RATE), 1)})


def cmd_calibrate_play(which):
    if which not in ("before", "after"):
        fail("play before or after")
    clip = read_file(RUNTIME_DIR, which + ".wav", 32 << 20, binary=True)
    if clip is None:
        fail("build the preview first")
    pcm = wav_frames(clip)
    player = spawn(["pacat", "--playback", "--format=s16le", "--rate=%d" % RATE, "--channels=1",
                    "--latency-msec=100"], stdin=subprocess.PIPE)
    if player is None:
        fail("couldn't play the clip")
    try:
        feed(player, pcm)
        player.wait(timeout=len(pcm) / float(RATE * 2) + 30.0)
    except subprocess.TimeoutExpired:
        pass
    finally:
        stop(player)
    emit({"ok": True})


def cmd_calibrate_clear():
    for name in ("speech.wav", "typing.wav", "before.wav", "after.wav", "preview.conf"):
        remove_file(RUNTIME_DIR, name)
    emit({"ok": True})


# ---------------------------------------------------------------- main

def main(argv):
    supervise()
    if not argv or argv[0] == "status":
        return cmd_status()
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == "on":
            return cmd_on("--keep-default" in rest)
        if cmd == "off":
            return cmd_off()
        if cmd == "default":
            return cmd_default()
        if cmd == "set" and len(rest) == 2:
            return cmd_set(rest[0], rest[1])
        if cmd == "device" and len(rest) == 1:
            return cmd_device(rest[0])
        if cmd == "devices":
            return emit({"ok": True, "devices": input_devices()})
        if cmd == "reset":
            return cmd_reset()
        if cmd == "render":
            settings = load_settings()
            sys.stdout.write(render(settings, resolve_device(settings)))
            return None
        if cmd == "uninstall":
            return cmd_uninstall()
        if cmd == "calibrate" and rest == ["solve"]:
            return cmd_calibrate_solve()
        if cmd == "calibrate" and rest == ["apply"]:
            return cmd_calibrate_apply()
        if cmd == "calibrate" and rest == ["preview"]:
            return cmd_calibrate_preview()
        if cmd == "calibrate" and len(rest) == 2 and rest[0] == "play":
            return cmd_calibrate_play(rest[1])
        if cmd == "calibrate" and rest == ["clear"]:
            return cmd_calibrate_clear()
        if cmd == "calibrate" and len(rest) == 2:
            return cmd_calibrate(rest[0], rest[1])
    except OSError as e:
        fail(str(e))
    sys.stderr.write(__doc__)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
