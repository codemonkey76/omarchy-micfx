    finally:
        sys.stdout.close()
        sys.stdout = saved


# ---------------------------------------------------------------- calibration
# Each phase records the raw device and the chain's output side by side. For
# the recording, the gate, compressor and limiter are bypassed, the input gain
# is set to 0 dB and suppression to full, so the chain's output is exactly what
# the gate would see after RNNoise. The user's settings come back afterwards,
# however the phase ends.

def record(device, seconds, on_level, keep=False, stats=None):
    procs = {}
    levels = {"raw": [], "fx": []}
    clip = []
    peak = [0.0]      # the raw device's loudest sample, to catch clipping at the interface
    def reader(key, source):
        p = subprocess.Popen(["parec", "-d", source, "--format=float32le", "--rate=%d" % RATE,
                              "--channels=1", "--raw", "--latency-msec=50"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        procs[key] = p
        need = WINDOW * 4
        buf = b""
        while True:
            chunk = p.stdout.read(need - len(buf))
            if not chunk:
                break
            buf += chunk
            if len(buf) == need:
                a = array.array("f", buf)
                levels[key].append(to_db(math.sqrt(sum(x * x for x in a) / len(a))))
                if key == "raw":
                    peak[0] = max(peak[0], max(a), -min(a))
                    if keep:
                        clip.append(buf)
                buf = b""
    threads = [threading.Thread(target=reader, args=("raw", device), daemon=True),
               threading.Thread(target=reader, args=("fx", SOURCE), daemon=True)]
    for t in threads:
        t.start()
    start = time.time()
    shown = 0
    try:
        while time.time() - start < seconds:
            time.sleep(0.1)
            n = min(len(levels["raw"]), len(levels["fx"]))
            if n > shown:
                on_level(levels["raw"][n - 1], levels["fx"][n - 1], time.time() - start)
                shown = n
    finally:
        for p in procs.values():
            p.terminate()
        for t in threads:
            t.join(timeout=2)
    n = min(len(levels["raw"]), len(levels["fx"]))
    if stats is not None:
        stats["peak"] = to_db(peak[0])
    return levels["raw"][:n], levels["fx"][:n], b"".join(clip)


def percentile(values, p):
    if not values:
        return -120.0
    s = sorted(values)
    return s[min(len(s) - 1, max(0, int(p * (len(s) - 1) + 0.5)))]


def cmd_calibrate(phase, seconds):
    if phase not in ("quiet", "speech", "typing"):
        fail("phase must be quiet, speech or typing")
    try:
        seconds = float(seconds)
    except ValueError:
        fail("seconds must be a number")
    seconds = min(30.0, max(3.0, seconds))
    if not source_present(SOURCE):
        fail("turn Mic FX on first")
    settings = load_settings()
    device = resolve_device(settings)
    measuring = dict(settings)
    measuring.update({"gain": 0.0, "suppress.enabled": True, "suppress.strength": 100.0, "suppress.vad": 0.0,
                      "gate.enabled": False, "comp.enabled": False, "limit.enabled": False})
    restore = lambda *_: apply_live(controls(settings))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
    if not apply_live(controls(measuring)):
        fail("could not reach the chain's controls")
    # Stdout is a pipe to the panel, so it's block-buffered: each level has
    # to be flushed or the meters only move once the recording ends.
    def show_level(r, f, t):
        sys.stdout.write("level %.1f %.1f %.1f\n" % (r, f, t))
        sys.stdout.flush()
    stats = {}
    try:
        time.sleep(0.3)   # let the bypass settle before measuring
        raw, fx, clip = record(device, seconds, show_level, keep=phase in ("speech", "typing"), stats=stats)
    finally:
        restore()
    if len(raw) < 10:
        fail("too little audio was recorded")
    summary = {
        "phase": phase, "seconds": round(len(raw) / 10.0, 1), "time": int(time.time()),
        "raw": {"p10": percentile(raw, 0.1), "p50": percentile(raw, 0.5), "p90": percentile(raw, 0.9),
                "p95": percentile(raw, 0.95), "max": max(raw), "peak": stats.get("peak", -120.0)},
        "fx": {"p10": percentile(fx, 0.1), "p50": percentile(fx, 0.5), "p90": percentile(fx, 0.9),
               "p95": percentile(fx, 0.95), "max": max(fx)},
        "windows": {"raw": [round(v, 1) for v in raw], "fx": [round(v, 1) for v in fx]},
    }
    write_file(CALIBRATION_DIR, phase + ".json", json.dumps(summary) + "\n")
    # A new recording makes any earlier preview stale.
    for stale in ("before.wav", "after.wav"):
        remove_file(RUNTIME_DIR, stale)
    if clip:
        write_file(RUNTIME_DIR, phase + ".wav", wav_bytes(array.array("f", clip)), 0o600)
    brief = {k: v for k, v in summary.items() if k != "windows"}
    sys.stdout.write("result " + json.dumps(brief) + "\n")
    sys.stdout.flush()


def solve():
    phases = {p: read_json(CALIBRATION_DIR, p + ".json", None) for p in ("quiet", "speech", "typing")}
    missing = [p for p, v in phases.items() if not v]
    if missing:
        return None, "record these phases first: " + ", ".join(missing)
    quiet, speech, typing = phases["quiet"], phases["speech"], phases["typing"]
    notes = []

    floor_raw = quiet["raw"]["p50"]
    floor_fx = quiet["fx"]["p90"]
    # Speech windows: clearly above the room's floor in the raw signal.
    raw_w, fx_w = speech["windows"]["raw"], speech["windows"]["fx"]
    active = [i for i, v in enumerate(raw_w) if v > floor_raw + 10]
    if len(active) < 10:
        return None, "the speech phase barely rose above the room's noise; try again closer to the mic, or turn up its gain"
    speech_raw = percentile([raw_w[i] for i in active], 0.5)
    speech_peak = max(raw_w[i] for i in active)
    speech_fx = percentile([fx_w[i] for i in active], 0.5)
    speech_fx_quiet = percentile([fx_w[i] for i in active], 0.2)
    typing_fx = typing["fx"]["p95"]
    typing_raw = typing["raw"]["p95"]

    # Input gain: bring average speech to about -24 dBFS before the dynamics.
    gain = round(min(24.0, max(0.0, -24.0 - speech_raw)), 1)
    gain = min(gain, max(0.0, -6.0 - speech_peak))   # keep loud peaks clear of clipping
    if gain > 12:
        notes.append("Your speech is quiet at the interface (about %.0f dBFS). Turning up the AI-1's gain knob "
                     "is better than %.0f dB of digital gain, which raises the noise with it." % (speech_raw, gain))
    # Too hot: clipping happens in the interface, before anything here can help.
    # Recordings from before the sample peak was tracked fall back to the
    # loudest 100 ms, which sits at least 6 dB under the sample peak for speech.
    sample_peak = min(0.0, max(speech["raw"].get("peak", speech_peak + 6),
                               typing["raw"].get("peak", typing["raw"]["max"] + 6)))
    over = speech_raw + 24
    if sample_peak > -1:
        notes.append("Your loudest sounds reach %.1f dBFS at the interface, which is clipping. Turn the AI-1's gain "
                     "knob down by about %.0f dB, so talking reads around -24 dBFS, and run the wizard again. "
                     "Nothing after the interface can undo clipping." % (sample_peak, max(3, over)))
    elif sample_peak > -4:
        notes.append("Your loudest sounds reach %.1f dBFS at the interface, close to clipping. Turning the AI-1's "
                     "gain knob down by about %.0f dB would leave safe headroom." % (sample_peak, max(3, over)))
    # Gate: open between the loudest non-speech after RNNoise and the quiet end of speech.
    lower = max(floor_fx, typing_fx) + gain + 4
    upper = speech_fx_quiet + gain - 3
    vad = 0.0
    if lower < upper:
        threshold = lower + (upper - lower) * 0.4
    else:
        threshold = upper
        vad = 60.0
        notes.append("Typing gets through RNNoise at about the level of your quieter speech, so the gate alone "
                     "can't separate them. Voice detection is switched on (60%) to cut typing between words.")
    threshold = round(min(-20.0, max(-80.0, threshold)), 1)
    # Compressor: threshold a little under average speech, output averaging about -18 dBFS.
    level = speech_fx + gain
    comp_th = round(min(-10.0, max(-50.0, level - 6)), 1)
    ratio = 3.0
    compressed = comp_th + (level - comp_th) / ratio if level > comp_th else level
    makeup = round(min(18.0, max(0.0, -18.0 - compressed)), 1)

    suggested = {"gain": gain, "suppress.enabled": True, "suppress.strength": 100.0, "suppress.vad": vad,
                 "gate.enabled": True, "gate.threshold": threshold, "gate.range": -30.0,
                 "comp.enabled": True, "comp.threshold": comp_th, "comp.ratio": ratio, "comp.makeup": makeup,
                 "limit.enabled": True, "limit.ceiling": -1.0}
    measured = {"floorRaw": round(floor_raw, 1), "floorAfterSuppression": round(floor_fx, 1),
                "speech": round(speech_raw, 1), "speechPeak": round(speech_peak, 1),
                "speechAfterSuppression": round(speech_fx, 1), "quietSpeechAfterSuppression": round(speech_fx_quiet, 1),
                "typing": round(typing_raw, 1), "typingAfterSuppression": round(typing_fx, 1),
                "suppressionDb": round(floor_raw - floor_fx, 1)}
    return {"measured": measured, "suggested": suggested, "notes": notes}, None


def cmd_calibrate_solve():
    result, error = solve()
    if error:
        fail(error)
    write_file(CALIBRATION_DIR, "suggestion.json", json.dumps(result) + "\n")
    emit(dict(ok=True, **result))


def cmd_calibrate_apply():
    result = read_json(CALIBRATION_DIR, "suggestion.json", None)
    if not result:
        result, error = solve()
        if error:
            fail(error)
    settings = load_settings()
    for key, value in result["suggested"].items():
        if key in SETTINGS:
            settings[key] = coerce(key, value)
    save_settings(settings)
    live = False
    if source_present(SOURCE):
        live = apply_live(controls(settings))
        write_file(PIPEWIRE_DIR, HOST_CONF, render(settings, resolve_device(settings)), 0o644)
    emit({"ok": True, "live": live, "settings": {k: settings[k] for k in SETTINGS}})


# ---------------------------------------------------------------- preview
# The wizard's last step plays the typing mixed over the talking, first as
# recorded and then through the suggested settings. The processed version
# comes from a throwaway copy of the chain fed through a temporary null sink,
# so the real chain, and any call using it, is never touched. Clips are
# played from memory through pacat's stdin, never re-opened by path.

def pcm16(samples):
    return array.array("h", (max(-32767, min(32767, int(s * 32767))) for s in samples)).tobytes()


def wav_bytes(samples):
    out = io.BytesIO()
    with wave.open(out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm16(samples))
    return out.getvalue()


def wav_frames(data):
    with wave.open(io.BytesIO(data), "rb") as w:
        if w.getnchannels() != 1 or w.getsampwidth() != 2 or w.getframerate() != RATE:
            raise ValueError("unexpected clip format")
        return w.readframes(w.getnframes())


def read_clip(name):
    data = read_file(RUNTIME_DIR, name, 32 << 20, binary=True)
    if data is None:
        return None
    return [x / 32767.0 for x in array.array("h", wav_frames(data))]


def feed(proc, pcm):
    # Writes block once pacat's buffer is full, so progress tracks playback.
    step = WINDOW * 2
    for offset in range(0, len(pcm), step):
        proc.stdin.write(pcm[offset:offset + step])
        sys.stdout.write("progress %.3f\n" % min(1.0, (offset + step) / float(len(pcm))))
        sys.stdout.flush()
    proc.stdin.close()


def stop(proc):
    if proc and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()


def suggested_settings():
    settings = load_settings()
    suggestion = read_json(CALIBRATION_DIR, "suggestion.json", None)
    if suggestion and isinstance(suggestion.get("suggested"), dict):
        for key, value in suggestion["suggested"].items():
            if key in SETTINGS:
                settings[key] = coerce(key, value)
    return settings


def default_sink():
    done = run(["pactl", "get-default-sink"])
    return done.stdout.strip() if done and done.returncode == 0 else ""


def cmd_calibrate_preview():
    speech, typing = read_clip("speech.wav"), read_clip("typing.wav")
    if not speech or not typing:
        fail("record the talking and typing steps first")
    # The typing runs under the whole of the talking, looped if it's shorter.
    mix = [max(-1.0, min(1.0, s + typing[i % len(typing)])) for i, s in enumerate(speech)]
    write_file(RUNTIME_DIR, "before.wav", wav_bytes(mix), 0o600)
    settings = suggested_settings()
    sink_before, source_before = default_sink(), default_source()
    module = chain = recorder = player = None
    captured = []
    lead = 0
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
    try:
        done = run(["pactl", "load-module", "module-null-sink", "sink_name=" + PREVIEW_SINK,
                    "sink_properties=device.description=Mic-FX-preview"])
        module = done.stdout.strip() if done and done.returncode == 0 else None
        if not module:
            fail("couldn't create the preview's temporary sink")
        write_file(RUNTIME_DIR, "preview.conf", render(settings, PREVIEW_SINK, preview=True), 0o600)
        chain = subprocess.Popen(["pipewire", "-c", os.path.join(RUNTIME_DIR, "preview.conf")],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not wait_for(lambda: source_present(PREVIEW_SOURCE), 8):
            fail("the preview chain didn't start")
        recorder = subprocess.Popen(["parec", "-d", PREVIEW_SOURCE, "--format=float32le", "--rate=%d" % RATE,
                                     "--channels=1", "--raw", "--latency-msec=50"],
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        def collect():
            while True:
                chunk = recorder.stdout.read(WINDOW * 4)
                if not chunk:
                    break
                captured.append(chunk)
        reader = threading.Thread(target=collect, daemon=True)
        reader.start()
        time.sleep(0.3)
        lead = sum(len(c) for c in captured) // 4      # samples recorded before the clip starts
        player = subprocess.Popen(["pacat", "--playback", "-d", PREVIEW_SINK, "--format=s16le",
                                   "--rate=%d" % RATE, "--channels=1", "--latency-msec=100"],
                                  stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        feed(player, pcm16(mix))
        player.wait(timeout=60)
        time.sleep(0.5)                                 # let the chain's tail through
        stop(recorder)
        reader.join(timeout=3)
    finally:
        for proc in (player, recorder, chain):
            stop(proc)
        if module:
            run(["pactl", "unload-module", module])
        if sink_before and default_sink() != sink_before:
            run(["pactl", "set-default-sink", sink_before])
        if source_before and default_source() != source_before:
            run(["pactl", "set-default-source", source_before])
        remove_file(RUNTIME_DIR, "preview.conf")
    processed = array.array("f", b"".join(captured))
    after = processed[lead:lead + len(mix)]
    if len(after) < RATE:
        fail("the preview chain returned too little audio")
    write_file(RUNTIME_DIR, "after.wav", wav_bytes(after), 0o600)
    emit({"ok": True, "seconds": round(len(mix) / float(RATE), 1)})


def cmd_calibrate_play(which):
    if which not in ("before", "after"):
        fail("play before or after")
    clip = read_file(RUNTIME_DIR, which + ".wav", 32 << 20, binary=True)
    if clip is None:
        fail("build the preview first")
    pcm = wav_frames(clip)
    player = subprocess.Popen(["pacat", "--playback", "--format=s16le", "--rate=%d" % RATE, "--channels=1",
                               "--latency-msec=100"], stdin=subprocess.PIPE,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
    try:
        feed(player, pcm)
        player.wait(timeout=90)
    except BrokenPipeError:
        pass
    finally:
        stop(player)
    emit({"ok": True})


def cmd_calibrate_clear():
    for name in ("speech.wav", "typing.wav", "before.wav", "after.wav", "preview.conf"):
        remove_file(RUNTIME_DIR, name)
    emit({"ok": True})


# ---------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] == "status":
        return cmd_status()
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == "on":
            return cmd_on("--keep-default" in rest)
        if cmd == "off":
            return cmd_off()
        if cmd == "default":
            return cmd_default()
        if cmd == "set" and len(rest) == 2:
            return cmd_set(rest[0], rest[1])
        if cmd == "device" and len(rest) == 1:
            return cmd_device(rest[0])
        if cmd == "devices":
            return emit({"ok": True, "devices": input_devices()})
        if cmd == "reset":
            return cmd_reset()
        if cmd == "render":
            settings = load_settings()
            sys.stdout.write(render(settings, resolve_device(settings)))
            return None
        if cmd == "uninstall":
            return cmd_uninstall()
        if cmd == "calibrate" and rest == ["solve"]:
            return cmd_calibrate_solve()
        if cmd == "calibrate" and rest == ["apply"]:
            return cmd_calibrate_apply()
        if cmd == "calibrate" and rest == ["preview"]:
            return cmd_calibrate_preview()
        if cmd == "calibrate" and len(rest) == 2 and rest[0] == "play":
            return cmd_calibrate_play(rest[1])
        if cmd == "calibrate" and rest == ["clear"]:
            return cmd_calibrate_clear()
        if cmd == "calibrate" and len(rest) == 2:
            return cmd_calibrate(rest[0], rest[1])
    except OSError as e:
        fail(str(e))
    sys.stderr.write(__doc__)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
