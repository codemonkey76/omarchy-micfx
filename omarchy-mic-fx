# ---------------------------------------------------------------- audio graph

class Done:
    """What a finished command said, in the shape subprocess.run returns."""
    __slots__ = ("returncode", "stdout")

    def __init__(self, returncode, stdout):
        self.returncode = returncode
        self.stdout = stdout


def drain(stream, limit, deadline):
    """Read a pipe until it closes. Gives up rather than keep reading once the
    output passes `limit` bytes or the clock passes `deadline`, so a command
    that floods or hangs can't grow this process without bound."""
    chunks, total = [], 0
    fd = stream.fileno()
    while True:
        left = deadline - time.monotonic()
        if left <= 0:
            return None
        try:
            ready = select.select([fd], [], [], min(left, 0.25))[0]
        except OSError:
            return None
        if not ready:
            continue
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            return None
        if not chunk:
            return b"".join(chunks).decode("utf-8", "replace")
        total += len(chunk)
        if total > limit:
            return None
        chunks.append(chunk)


def run(args, timeout=10, check=False, limit=MAX_OUTPUT):
    """Run a trusted program to completion under an absolute deadline, reading
    its output as it comes rather than buffering whatever it decides to say."""
    proc = spawn(args, stdout=subprocess.PIPE)
    if proc is None:
        return None
    deadline = time.monotonic() + timeout
    out = drain(proc.stdout, limit, deadline)
    if out is not None:
        try:
            proc.wait(timeout=max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            out = None
    code = proc.returncode
    stop(proc)
    if out is None or (check and code != 0):
        return None
    return Done(code, out)


def sources():
    done = run(["pactl", "-f", "json", "list", "sources"])
    if not done or done.returncode != 0:
        return []
    try:
        return json.loads(done.stdout)
    except ValueError:
        return []


def input_devices():
    out = []
    for src in sources():
        name = src.get("name", "")
        props = src.get("properties", {})
        # Not our own sources (the chain, its preview), and not monitors of outputs.
        if name.startswith(SOURCE) or name.endswith(".monitor") or props.get("device.class") == "monitor":
            continue
        if not valid_node_name(name):
            continue
        out.append({"name": name, "description": src.get("description") or name,
                    "channels": src.get("channel_map", "").count(",") + 1 if src.get("channel_map") else 1})
    return out


def default_source():
    done = run(["pactl", "get-default-source"])
    return done.stdout.strip() if done and done.returncode == 0 else ""


def source_present(name):
    return any(src.get("name") == name for src in sources())


def capture_node_id():
    done = run(["pw-dump"], timeout=10)
    if not done or done.returncode != 0:
        return None
    try:
        for obj in json.loads(done.stdout):
            props = (obj.get("info") or {}).get("props") or {}
            if obj.get("type") == "PipeWire:Interface:Node" and props.get("node.name") == CAPTURE:
                return obj.get("id")
    except ValueError:
        pass
    return None


# Device descriptions come from the hardware (a USB device names itself), so
# they're quoted, stripped of control characters and capped before they go
# into the generated config.
def spa_string(text):
    text = "".join(ch for ch in str(text)[:200] if ch >= " " and ch != "\x7f")
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def source_state():
    for src in sources():
        if src.get("name") == SOURCE:
            return src.get("state", "")
    return ""


def node_controls(node):
    done = run(["pw-dump", str(node)], timeout=10)
    found = {}
    if not done or done.returncode != 0:
        return found
    try:
        for obj in json.loads(done.stdout):
            for props in ((obj.get("info") or {}).get("params") or {}).get("Props") or []:
                params = props.get("params") or []
                for i in range(0, len(params) - 1, 2):
                    if isinstance(params[i], str) and isinstance(params[i + 1], (int, float)):
                        found[params[i]] = float(params[i + 1])
    except ValueError:
        pass
    return found


def controls_match(node, values):
    current = node_controls(node)
    return all(k in current and abs(current[k] - float(v)) <= 1e-4 * max(1.0, abs(float(v))) for k, v in values.items())


# A chain that hasn't processed audio since it started is suspended and
# ignores control changes, so hold it awake with a throwaway recording while
# they land, then read them back rather than assume.
def apply_live(values):
    node = capture_node_id()
    if node is None:
        return False
    waker = spawn(["parec", "-d", SOURCE, "--raw"])
    if waker is None:
        return False
    try:
        wait_for(lambda: source_state() == "RUNNING", 3)
        params = " ".join("%s %s" % (spa_string(k), repr(float(v))) for k, v in values.items())
        run(["pw-cli", "set-param", str(node), "Props", "{ params = [ %s ] }" % params])
        return wait_for(lambda: controls_match(node, values), 3)
    finally:
        stop(waker)


def resolve_device(settings):
    if settings["device"]:
        return settings["device"]
    current = default_source()
    if current and current != SOURCE and valid_node_name(current):
        return current
    devices = input_devices()
    return devices[0]["name"] if devices else ""


def describe(device):
    for d in input_devices():
        if d["name"] == device:
            return d["description"]
    return device


# With preview, the chain is a throwaway copy that captures a temporary sink
# instead of a microphone, under its own node names.
