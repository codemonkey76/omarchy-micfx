        items = ["%s = %s" % (spa_string(k.split(":", 1)[1]), fmt(v)) for k, v in c.items() if k.startswith(prefix + ":")]
        return "{ " + " ".join(items) + " }"
    label = spa_string("Mic FX preview" if preview else describe(device) + " (Mic FX)")
    return """# Written by omarchy-mic-fx. Changes here are overwritten; use the widget or
