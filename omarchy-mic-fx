def systemctl(*args):
    return run(["systemctl", "--user"] + list(args), timeout=30)


def service_state():
    done = systemctl("is-active", UNIT)
    active = done.stdout.strip() if done else "unknown"
    done = systemctl("is-enabled", UNIT)
    enabled = done.stdout.strip() if done else "unknown"
    return active or "inactive", enabled or "disabled"


def deps_present():
    return {"rnnoise": os.path.exists(RNNOISE),
            "lsp": all(os.path.exists(os.path.join(LSP, p + ".ttl")) for p in ("gate_mono", "compressor_mono", "limiter_mono"))}


def install_files(settings, device):
    write_file(PIPEWIRE_DIR, HOST_CONF, render(settings, device), 0o644)
    write_file(UNIT_DIR, UNIT, UNIT_TEXT, 0o644)
    systemctl("daemon-reload")


# Recording streams from apps. Our own capture stream carries no application name.
def app_source_outputs(on_source):
    done = run(["pactl", "-f", "json", "list", "source-outputs"])
    if not done or done.returncode != 0:
        return []
    try:
        outputs = json.loads(done.stdout)
    except ValueError:
        return []
    index = {src.get("index"): src.get("name") for src in sources()}
    ids = []
    for out in outputs:
        props = out.get("properties", {})
        if props.get("node.name") == CAPTURE or not props.get("application.name"):
            continue
        if index.get(out.get("source")) == on_source:
            ids.append(str(out.get("index")))
    return ids


def move_apps(from_source, to_source):
    for oid in app_source_outputs(from_source):
        run(["pactl", "move-source-output", oid, to_source])


def wait_for(predicate, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if predicate():
            return True
        time.sleep(0.25)
    return predicate()


